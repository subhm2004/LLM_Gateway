{
  "name": "llm-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/src/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch --experimental-transform-types src/index.ts",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-transform-types scripts/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:pg": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-transform-types --test test/postgres.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "fastify": "^5.6.1",
    "openai": "^6.9.0",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
