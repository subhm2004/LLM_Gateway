NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

ADMIN_TOKEN=

DATABASE_URL=
SQLITE_PATH=./data/gateway.db

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

PROVIDER_TIMEOUT_MS=30000
REQUEST_DEADLINE_MS=70000
MAX_RETRIES_PER_TARGET=1
RETRY_BASE_DELAY_MS=250
RETRY_MAX_DELAY_MS=4000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000

ESTIMATE_SAFETY_FACTOR=1.15
RESERVATION_TTL_MS=120000
RESERVATION_SWEEP_INTERVAL_MS=30000

CACHE_ENABLED=false
CACHE_MAX_ENTRIES=500
CACHE_TTL_MS=300000

MODEL_CATALOG_PATH=./config/models.json
ALLOW_FAULT_INJECTION=false
